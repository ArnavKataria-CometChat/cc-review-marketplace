<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice & video calling (CometChat Calls). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- Ongoing-call foreground service (kit-provided service; permissions must
         still be declared here — manifest merge does not pull them across AARs). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <application
        android:name=".MarketplaceApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marketplace"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Marketplace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity" />
        <activity android:name=".ui.main.MainActivity" />
        <activity android:name=".ui.listings.ListingDetailActivity" />
        <activity android:name=".ui.listings.CreateListingActivity" />
        <activity android:name=".ui.inquiries.InquiryDetailActivity" />
        <activity android:name=".ui.reports.ReportDetailActivity" />

        <!-- CometChat chat + call surface. Uses the CometChat theme (its Kotlin
             Views components require CometChatTheme.DayNight attributes). -->
        <activity
            android:name=".ui.chat.ConversationsActivity"
            android:theme="@style/Theme.Marketplace.CometChat" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:theme="@style/Theme.Marketplace.CometChat" />

        <!-- Disable Picture-in-Picture on the CometChat call surfaces. The UIKit
             declares them with supportsPictureInPicture="true"; because they also
             declare configChanges=screenSize|screenLayout|orientation, entering
             PiP (home/minimise during a call) resizes the React-Native/Jitsi call
             surface to the small PiP window and it never re-measures on return —
             leaving the call UI stuck in a narrow left strip with the rest black.
             Override to false so minimise/reopen keeps a full-screen layout. -->
        <activity
            android:name="com.cometchat.uikit.kotlin.calls.CometChatCallActivity"
            android:supportsPictureInPicture="false"
            tools:replace="android:supportsPictureInPicture" />
        <activity
            android:name="com.cometchat.uikit.kotlin.presentation.ongoingcall.ui.CometChatOngoingCallActivity"
            android:supportsPictureInPicture="false"
            tools:replace="android:supportsPictureInPicture" />

    </application>

</manifest>
