# Copy to .env and adjust. Never commit real secrets.

# HTTP port the server listens on.
PORT=8080

# Secret used to sign session JWTs. Set a long random value in production.
JWT_SECRET=dev-only-insecure-secret-change-me

# Session token lifetime (Go duration, e.g. 24h, 30m).
TOKEN_TTL=24h

# Seed demo users/listings on startup (true/false).
SEED_DEMO_DATA=true

# ---- CometChat ----
# App ID + Region are non-secret and handed to clients along with a per-user
# auth token minted by the backend. The REST API Key is fullAccess and MUST stay
# server-side (it provisions users, mints tokens and manages dispute groups) —
# never ship it in a web/mobile bundle. The Auth Key is dev-only and is NOT used
# by this backend (the token flow supersedes it); it is listed only for parity.
# Leave any of these blank to run the API with chat disabled (endpoints degrade
# gracefully). Put real values in a gitignored .env, never in source or commits.
COMETCHAT_APP_ID=
COMETCHAT_REGION=
COMETCHAT_REST_API_KEY=
COMETCHAT_AUTH_KEY=
