# Copy to .env for local dev. These are build-time variables (Vite inlines any
# VITE_-prefixed var into the bundle), so a production build must set them before
# `npm run build` / `docker build --build-arg`.

# Base URL of the marketplace backend REST API.
#   - Leave UNSET for local `npm run dev`: the Vite dev server proxies /api ->
#     http://localhost:8080 (see vite.config.ts), so the app calls "/api".
#   - Set to the backend's public URL for a real deployment, e.g.
#     VITE_API_BASE_URL=https://api.marketplace.example.com
# VITE_API_BASE_URL=http://localhost:8080
