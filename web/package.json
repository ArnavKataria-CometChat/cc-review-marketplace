{
  "name": "marketplace-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Peer-to-peer marketplace web client (Phase A baseline, no chat).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
